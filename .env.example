# Copie este arquivo para .env e preencha. Nunca compartilhe o .env.

# --- Segurança do bot ---
# Seu número pessoal (o que vai MANDAR mensagens para o bot), só dígitos, com 55 + DDD.
# Para liberar mais de um número, separe por vírgula.
ALLOWED_NUMBERS=5511999999999
# Texto aleatório e longo que vai no endereço do webhook. Gere com:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
WEBHOOK_SECRET=troque-por-um-texto-aleatorio

# --- Evolution API ---
# Endereço da sua Evolution (sem barra no final) e a chave global (AUTHENTICATION_API_KEY).
EVOLUTION_URL=http://IP_DO_VPS:8080
EVOLUTION_API_KEY=sua-chave-da-evolution
# Nome da instância conectada ao chip secundário do bot.
EVOLUTION_INSTANCE=bot-ticktick

# --- Anthropic (Claude) ---
# Crie em https://console.anthropic.com -> API Keys.
ANTHROPIC_API_KEY=
# Modelo:
#   claude-sonnet-5-5 -> bom equilíbrio entre qualidade e custo (padrão)
#   claude-haiku-5-5  -> o mais barato e rápido (cerca de 1/20 do custo do Sonnet)
ANTHROPIC_MODEL=claude-sonnet-5-5
# Nível de esforço (low | medium | high). "low" responde mais rápido e gasta menos,
# mas pode pular consultas; "medium" é o equilíbrio recomendado.
ANTHROPIC_EFFORT=medium

# --- TickTick ---
# Preenchido automaticamente pelo comando:  npm run ticktick-login
TICKTICK_TOKEN=
TICKTICK_MCP_URL=https://mcp.ticktick.com

# --- Conversa ---
TZ=America/Sao_Paulo
# A conversa recomeça do zero após X minutos parada ou após N trocas.
IDLE_RESET_MINUTES=30
MAX_TURNS=20
PORT=3000
